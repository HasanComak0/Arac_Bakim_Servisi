@{
    ViewData["Title"] = "Araç Bakım Rehberi";
}

<!-- HERO -->
<section class="maintenance-hero">
    <div class="container">
        <div class="maintenance-hero-content">
            <span class="maintenance-eyebrow">
                KURT OTOMOTİV · BİLGİ REHBERİ
            </span>

            <h1>
                Aracınızı tanıyın.<br />
                <span>Bakımını ihmal etmeyin.</span>
            </h1>

            <p>
                Aracınızın temel bakım ihtiyaçlarını öğrenin,
                olası sorunların belirtilerini tanıyın ve bakım
                sürecinizi daha bilinçli yönetin.
            </p>

            <div class="maintenance-hero-actions">
                <a href="#bakim-konulari" class="maintenance-primary-btn">
                    Bakım Rehberini Keşfet
                    <i class="bi bi-arrow-down"></i>
                </a>

                <a href="#kontrol-listesi" class="maintenance-text-btn">
                    Kontrol Listesine Git
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="maintenance-hero-note">
                <i class="bi bi-info-circle"></i>
                <span>
                    Bakım önerileri aracınızın üretici talimatlarıyla
                    birlikte değerlendirilmelidir.
                </span>
            </div>
        </div>

        <div class="maintenance-hero-visual">
            <div class="maintenance-visual-top">
                <i class="bi bi-speedometer2"></i>
                <span>Aracınız için bakım rehberi</span>
            </div>

            <div class="maintenance-visual-center">
                <i class="bi bi-car-front-fill"></i>
            </div>

            <div class="maintenance-visual-bottom">
                <div>
                    <i class="bi bi-check-circle"></i>
                    <span>Kontrollerini öğren</span>
                </div>
                <div>
                    <i class="bi bi-calendar-check"></i>
                    <span>Bakımını takip et</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HIZLI NAVİGASYON -->
<section class="maintenance-shortcuts">
    <div class="container">
        <a href="#bakim-konulari">
            <i class="bi bi-wrench-adjustable"></i>
            <span>Bakım Konuları</span>
        </a>

        <a href="#bakim-plani">
            <i class="bi bi-calendar3"></i>
            <span>Bakım Planı</span>
        </a>

        <a href="#kontrol-listesi">
            <i class="bi bi-list-check"></i>
            <span>Kontrol Listesi</span>
        </a>

        <a href="#uyari-isaretleri">
            <i class="bi bi-exclamation-triangle"></i>
            <span>Uyarı İşaretleri</span>
        </a>
    </div>
</section>

<!-- BAKIM KONULARI -->
<section class="maintenance-intro section-spacing" id="bakim-konulari">
    <div class="container">
        <div class="maintenance-section-heading">
            <span class="maintenance-label">TEMEL BİLGİLER</span>
            <h2>Aracınızın bakımını nereden başlamalısınız?</h2>
            <p>
                Düzenli bakım yalnızca arıza meydana geldiğinde
                servise gitmek değildir. Amaç, aracın üretici tarafından
                belirtilen bakım ihtiyaçlarını takip etmek ve güvenliği
                etkileyen sorunları erken fark etmektir.
            </p>
        </div>

        <div class="maintenance-topic-grid">
            <article class="maintenance-topic">
                <div class="topic-number">01</div>
                <div class="topic-icon">
                    <i class="bi bi-droplet-half"></i>
                </div>
                <h3>Motor yağı ve filtreler</h3>
                <p>
                    Motor yağının seviyesi ve durumu ile yağ filtresi,
                    hava filtresi ve aracınıza uygun diğer filtrelerin
                    bakım gereksinimleri takip edilmelidir.
                </p>
                <details>
                    <summary>Nelere dikkat edilmeli?</summary>
                    <ul>
                        <li>Yağ seviyesini araç kılavuzundaki yönteme göre kontrol edin.</li>
                        <li>Yağ değişimini üreticinin belirttiği aralıkta yaptırın.</li>
                        <li>Yağ basıncı uyarısı yanarsa güvenli yerde durun ve motoru kapatın.</li>
                    </ul>
                </details>
            </article>

            <article class="maintenance-topic">
                <div class="topic-number">02</div>
                <div class="topic-icon">
                    <i class="bi bi-disc"></i>
                </div>
                <h3>Fren sistemi</h3>
                <p>
                    Fren balataları, diskler, fren hidroliği ve sistemin
                    genel durumu güvenli sürüş açısından önemlidir.
                </p>
                <details>
                    <summary>Nelere dikkat edilmeli?</summary>
                    <ul>
                        <li>Fren yaparken metalik ses veya belirgin titreşim oluşmasını önemseyin.</li>
                        <li>Fren pedalında alışılmadık değişiklik fark ederseniz kontrol ettirin.</li>
                        <li>Fren uyarı lambasını görmezden gelmeyin.</li>
                    </ul>
                </details>
            </article>

            <article class="maintenance-topic">
                <div class="topic-number">03</div>
                <div class="topic-icon">
                    <i class="bi bi-circle"></i>
                </div>
                <h3>Lastikler ve basınç</h3>
                <p>
                    Doğru lastik basıncı, yeterli diş derinliği ve
                    düzensiz aşınmaların kontrolü yol tutuşu etkiler.
                </p>
                <details>
                    <summary>Nelere dikkat edilmeli?</summary>
                    <ul>
                        <li>Basıncı mümkünse lastikler soğukken ölçün.</li>
                        <li>Üreticinin önerdiği basınç değerlerini kullanın.</li>
                        <li>Kesik, balon, çatlak veya düzensiz aşınma olup olmadığına bakın.</li>
                    </ul>
                </details>
            </article>

            <article class="maintenance-topic">
                <div class="topic-number">04</div>
                <div class="topic-icon">
                    <i class="bi bi-thermometer-half"></i>
                </div>
                <h3>Soğutma sistemi</h3>
                <p>
                    Motorun çalışma sıcaklığının korunması için soğutma
                    sıvısı ve sistemin durumu önemlidir.
                </p>
                <details>
                    <summary>Nelere dikkat edilmeli?</summary>
                    <ul>
                        <li>Soğutma sıvısı seviyesini yalnızca güvenli koşullarda kontrol edin.</li>
                        <li>Tekrarlayan sıvı eksilmesini araştırmadan bırakmayın.</li>
                        <li>Motor sıcakken basınçlı soğutma sistemi kapağını açmayın.</li>
                    </ul>
                </details>
            </article>

            <article class="maintenance-topic">
                <div class="topic-number">05</div>
                <div class="topic-icon">
                    <i class="bi bi-lightbulb"></i>
                </div>
                <h3>Aydınlatma ve görüş</h3>
                <p>
                    Farlar, sinyaller, fren lambaları, silecekler ve
                    cam yıkama sistemi görüş ve görünürlük için gereklidir.
                </p>
                <details>
                    <summary>Nelere dikkat edilmeli?</summary>
                    <ul>
                        <li>Farları ve sinyalleri düzenli olarak kontrol edin.</li>
                        <li>Silecekler camda iz bırakıyor veya görüşü bozuyorsa değiştirin.</li>
                        <li>Cam yıkama sıvısını mevsime uygun seçin.</li>
                    </ul>
                </details>
            </article>

            <article class="maintenance-topic">
                <div class="topic-number">06</div>
                <div class="topic-icon">
                    <i class="bi bi-battery-charging"></i>
                </div>
                <h3>Akü ve elektrik sistemi</h3>
                <p>
                    Akünün durumu ve şarj sistemi özellikle ilk çalıştırma
                    sorunlarının ve elektrik arızalarının belirlenmesinde önemlidir.
                </p>
                <details>
                    <summary>Nelere dikkat edilmeli?</summary>
                    <ul>
                        <li>Marşın zor dönmesi veya ışıkların belirgin zayıflaması durumunu takip edin.</li>
                        <li>Akü kutup başlarına ve bağlantılara uzman kontrolü yaptırın.</li>
                        <li>Akü uyarı lambası yanarsa şarj sistemini kontrol ettirin.</li>
                    </ul>
                </details>
            </article>
        </div>
    </div>
</section>

<!-- BAKIM PLANI -->
<section class="maintenance-plan section-spacing" id="bakim-plani">
    <div class="container">
        <div class="maintenance-section-heading">
            <span class="maintenance-label">BAKIM TAKİBİ</span>
            <h2>Bakım planınızı nasıl oluşturabilirsiniz?</h2>
            <p>
                Her araç için geçerli tek bir kilometre veya süre yoktur.
                Aracınızın kullanım kılavuzundaki bakım çizelgesini esas alın.
            </p>
        </div>

        <div class="maintenance-timeline">
            <div class="timeline-item">
                <div class="timeline-marker">1</div>
                <div>
                    <span class="timeline-tag">İLK ADIM</span>
                    <h3>Aracınızın bakım bilgilerini bulun</h3>
                    <p>
                        Marka, model, model yılı ve motor seçeneğine uygun
                        kullanım kılavuzunu bulun. Bakım aralıkları motor
                        tipine ve kullanım koşullarına göre değişebilir.
                    </p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-marker">2</div>
                <div>
                    <span class="timeline-tag">KAYIT</span>
                    <h3>Son bakım tarihini ve kilometresini not edin</h3>
                    <p>
                        Faturaları ve servis kayıtlarını saklayın. Hangi
                        işlemlerin yapıldığını ve sonraki bakım için
                        belirtilen zamanı kaydedin.
                    </p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-marker">3</div>
                <div>
                    <span class="timeline-tag">TAKİP</span>
                    <h3>Hem zamanı hem kilometreyi takip edin</h3>
                    <p>
                        Üretici bakım aralığını kilometreye, zamana veya
                        her ikisine göre tanımlayabilir. Yoğun trafik,
                        kısa mesafe ve ağır kullanım koşulları da bakım
                        gereksinimlerini etkileyebilir.
                    </p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-marker">4</div>
                <div>
                    <span class="timeline-tag">KONTROL</span>
                    <h3>Belirti ortaya çıkmasını beklemeyin</h3>
                    <p>
                        Gösterge uyarıları, sıvı eksilmesi, alışılmadık
                        sesler ve sürüş davranışındaki değişiklikler
                        planlı bakım zamanından bağımsız değerlendirilmelidir.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- KONTROL LİSTESİ -->
<section class="maintenance-checklist-section section-spacing"
         id="kontrol-listesi">
    <div class="container">
        <div class="checklist-layout">
            <div class="checklist-intro">
                <span class="maintenance-label">KENDİNİZ KONTROL EDİN</span>
                <h2>Temel araç kontrol listeniz</h2>
                <p>
                    Bu listeyi aracınızı kullanmadan önce veya düzenli
                    kontrolleriniz sırasında hatırlatıcı olarak kullanın.
                    Kontrolleri yalnızca güvenli koşullarda gerçekleştirin.
                </p>

                <div class="checklist-warning">
                    <i class="bi bi-shield-exclamation"></i>
                    <span>
                        Bu liste profesyonel bakımın veya teknik incelemenin
                        yerine geçmez.
                    </span>
                </div>
            </div>

            <div class="checklist-panel">
                <div class="checklist-panel-header">
                    <div>
                        <span>HIZLI KONTROL</span>
                        <h3>Kontrol ettiklerim</h3>
                    </div>
                    <i class="bi bi-clipboard2-check"></i>
                </div>

                <label class="maintenance-check">
                    <input type="checkbox" />
                    <span>Lastiklerde görünür hasar var mı kontrol ettim.</span>
                </label>

                <label class="maintenance-check">
                    <input type="checkbox" />
                    <span>Farların ve sinyallerin çalışmasını kontrol ettim.</span>
                </label>

                <label class="maintenance-check">
                    <input type="checkbox" />
                    <span>Gösterge panelindeki uyarıları kontrol ettim.</span>
                </label>

                <label class="maintenance-check">
                    <input type="checkbox" />
                    <span>Aracın altında olağandışı sıvı sızıntısı olup olmadığına baktım.</span>
                </label>

                <label class="maintenance-check">
                    <input type="checkbox" />
                    <span>Bakım kayıtlarımı ve sonraki bakım zamanını kontrol ettim.</span>
                </label>

                <p class="checklist-footnote">
                    İşaretlemeler şimdilik bu sayfa açıkken kullanılır;
                    kalıcı kayıt oluşturulmaz.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- UYARI İŞARETLERİ -->
<section class="maintenance-warning-section section-spacing"
         id="uyari-isaretleri">
    <div class="container">
        <div class="maintenance-section-heading">
            <span class="maintenance-label">ÖNEMLİ UYARILAR</span>
            <h2>Hangi belirtileri görmezden gelmemelisiniz?</h2>
            <p>
                Bazı belirtiler aracı kullanmaya devam etmenin güvenli
                olmayabileceğini gösterir.
            </p>
        </div>

        <div class="warning-grid">
            <article class="warning-card">
                <i class="bi bi-exclamation-octagon"></i>
                <h3>Yağ basıncı uyarısı</h3>
                <p>
                    Güvenli bir yerde durun ve motoru kapatın.
                    Uyarının nedenini öğrenmeden sürüşe devam etmeyin.
                </p>
            </article>

            <article class="warning-card">
                <i class="bi bi-thermometer-high"></i>
                <h3>Motor aşırı ısınıyor</h3>
                <p>
                    Güvenli şekilde durun. Sıcak soğutma sistemi kapağını
                    açmayın; yardım veya teknik kontrol alın.
                </p>
            </article>

            <article class="warning-card">
                <i class="bi bi-exclamation-triangle"></i>
                <h3>Frenlerde ciddi sorun</h3>
                <p>
                    Fren performansında belirgin kayıp veya fren sistemi
                    uyarısı varsa aracı kullanmaya devam etmeyin.
                </p>
            </article>

            <article class="warning-card">
                <i class="bi bi-bell"></i>
                <h3>Yeni ses veya titreşim</h3>
                <p>
                    Özellikle aniden başlayan, şiddetli veya sürüşü
                    etkileyen belirtileri gecikmeden kontrol ettirin.
                </p>
            </article>
        </div>

        <div class="maintenance-emergency-note">
            <i class="bi bi-info-circle-fill"></i>
            <p>
                Kırmızı uyarılar, fren sorunu, aşırı ısınma veya güvenliği
                etkileyen bir arıza varsa güvenli yerde durun. Aracın
                durumuna göre yol yardımından destek alın.
            </p>
        </div>
    </div>
</section>

<!-- ALT ÇAĞRI -->
<section class="maintenance-bottom-cta">
    <div class="container">
        <div class="maintenance-bottom-cta-inner">
            <div>
                <span>BAKIM ZAMANINIZ MI GELDİ?</span>
                <h2>Aracınız için servis desteği alın.</h2>
                <p>
                    Bakım ihtiyacınızı değerlendirmek ve servis süreci
                    hakkında bilgi almak için bizimle iletişime geçin.
                </p>
            </div>

            <a asp-controller="Services"
               asp-action="Index"
               class="maintenance-primary-btn">
                Hizmetlerimizi İncele
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>