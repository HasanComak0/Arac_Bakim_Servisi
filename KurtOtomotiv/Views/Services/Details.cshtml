@model KurtOtomotiv.Models.ServiceViewModel

@{
    ViewData["Title"] = Model.Title;
}

<!-- HİZMET DETAY HERO -->
<section class="service-detail-hero">
    <div class="container">

        <div class="service-detail-hero-content">

            <a asp-controller="Services"
               asp-action="Index"
               class="service-detail-back">
                <i class="bi bi-arrow-left"></i>
                Tüm Hizmetler
            </a>

            <span class="service-detail-eyebrow">
                KURT OTOMOTİV · SERVİS VE BAKIM
            </span>

            <h1>@Model.Title</h1>

            <p>@Model.Description</p>

            <div class="service-detail-hero-actions">
                <a asp-controller="Contact"
                   asp-action="Index"
                   class="service-detail-primary-button">
                    <i class="bi bi-telephone"></i>
                    İletişime Geç
                </a>

                <a href="#yapilan-islemler"
                   class="service-detail-secondary-button">
                    Yapılan İşlemler
                    <i class="bi bi-arrow-down"></i>
                </a>
            </div>

        </div>

        <div class="service-detail-hero-visual">

            <img src="@Model.ImageUrl"
                 alt="@Model.Title"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

            <div class="service-detail-image-fallback">
                <i class="bi bi-tools"></i>
                <span>@Model.Title</span>
            </div>

            <div class="service-detail-image-caption">
                <i class="bi bi-wrench-adjustable-circle"></i>
                <span>Servis ve bakım hizmetleri</span>
            </div>

        </div>

    </div>
</section>


<!-- HİZMET AÇIKLAMASI -->
<section class="service-detail-overview section-spacing">
    <div class="container">

        <div class="service-overview-layout">

            <div class="service-overview-heading">
                <span class="maintenance-label">HİZMET HAKKINDA</span>

                <h2>
                    @Model.Title hizmeti hakkında bilmeniz gerekenler
                </h2>
            </div>

            <div class="service-overview-description">
                <p>@Model.Description</p>

                <p>
                    Yapılacak işlemler aracın mevcut durumuna,
                    marka ve modeline ve tespit edilen ihtiyaçlara
                    göre değişebilir. Aracınıza uygun hizmetin kapsamı
                    için bizimle iletişime geçebilirsiniz.
                </p>
            </div>

        </div>

    </div>
</section>


<!-- YAPILAN İŞLEMLER -->
<section class="service-detail-operations section-spacing"
         id="yapilan-islemler">

    <div class="container">

        <div class="service-detail-section-heading">
            <span class="maintenance-label">SERVİS KAPSAMI</span>

            <h2>Bu hizmet kapsamında</h2>

            <p>
                @Model.Title hizmetiyle ilişkili temel işlem ve
                kontrol başlıklarını aşağıda inceleyebilirsiniz.
            </p>
        </div>

        <div class="service-operation-grid">

            @for (var i = 0; i < Model.Features.Count; i++)
            {
                <article class="service-operation-card">

                    <div class="service-operation-top">
                        <div class="service-operation-icon">
                            <i class="bi bi-check2-circle"></i>
                        </div>

                        <span>
                            @((i + 1).ToString("D2"))
                        </span>
                    </div>

                    <h3>@Model.Features[i]</h3>

                    <p>
                        Bu işlem aracın ihtiyacına göre değerlendirilir.
                        Kontrolün kapsamı ve gerekli uygulamalar,
                        aracın durumuna göre belirlenir.
                    </p>

                </article>
            }

        </div>

        <div class="service-operation-note">
            <i class="bi bi-info-circle"></i>

            <p>
                Bu listedeki başlıklar genel bilgilendirme amaçlıdır.
                Her işlemin her araçta gerekli olacağı anlamına gelmez.
                İşletmede sunulan hizmetleri ve kapsamlarını önceden
                teyit etmenizi öneririz.
            </p>
        </div>

    </div>
</section>


<!-- SERVİS SÜRECİ -->
<section class="service-detail-process section-spacing">
    <div class="container">

        <div class="service-detail-section-heading">
            <span class="maintenance-label">SERVİS SÜRECİ</span>

            <h2>Nasıl ilerleyebilirsiniz?</h2>

            <p>
                Servis ihtiyacınızı belirlemekten yapılacak işlemleri
                öğrenmeye kadar izleyebileceğiniz temel adımlar.
            </p>
        </div>

        <div class="service-process-grid">

            <article class="service-process-item">
                <span class="service-process-number">01</span>

                <i class="bi bi-chat-square-text"></i>

                <h3>İhtiyacınızı anlatın</h3>

                <p>
                    Aracınızın durumunu ve yaşadığınız sorunu
                    işletmeye iletin.
                </p>
            </article>

            <article class="service-process-item">
                <span class="service-process-number">02</span>

                <i class="bi bi-search"></i>

                <h3>Gerekli kontrolleri öğrenin</h3>

                <p>
                    Aracınıza uygun inceleme ve servis işlemleri
                    hakkında bilgi alın.
                </p>
            </article>

            <article class="service-process-item">
                <span class="service-process-number">03</span>

                <i class="bi bi-clipboard-check"></i>

                <h3>İşlemleri netleştirin</h3>

                <p>
                    Yapılacak işlemleri ve servis koşullarını
                    uygulama öncesinde görüşün.
                </p>
            </article>

        </div>

    </div>
</section>


<!-- ALT CTA -->
<section class="service-detail-bottom-cta">
    <div class="container">

        <div class="service-detail-bottom-cta-inner">

            <div>
                <span>KURT OTOMOTİV</span>

                <h2>
                    @Model.Title hakkında bilgi almak ister misiniz?
                </h2>

                <p>
                    Aracınıza uygun hizmetin kapsamını öğrenmek
                    için bizimle iletişime geçebilirsiniz.
                </p>
            </div>

            <a asp-controller="Contact"
               asp-action="Index"
               class="service-detail-cta-button">
                İletişime Geç
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </div>
</section>