@{
    ViewData["Title"] = "Hizmetlerimiz";
}

<!-- SAYFA HERO -->
<section class="services-hero">
    <div class="container">
        <div class="services-hero-content">
            <span class="services-eyebrow">
                KURT OTOMOTİV · SERVİS VE BAKIM
            </span>

            <h1>
                Aracınız için<br />
                <span>doğru servis desteği.</span>
            </h1>

            <p>
                Araç bakım ve onarım ihtiyaçlarınızı değerlendirin,
                sunduğumuz hizmetleri inceleyin ve ihtiyacınıza uygun
                servis süreci hakkında bilgi alın.
            </p>

            <div class="services-hero-actions">
                <a href="#hizmet-listesi" class="services-hero-button">
                    Hizmetleri İncele
                    <i class="bi bi-arrow-down"></i>
                </a>

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="services-hero-link">
                    İletişime Geç
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>

        <div class="services-hero-visual">
            <div class="services-visual-symbol">
                <i class="bi bi-tools"></i>
            </div>

            <span>BAKIM · ONARIM · SERVİS</span>

            <h2>İhtiyacınızı belirleyin.</h2>

            <p>
                Hizmetlerimizi inceleyin ve aracınız için
                gereken desteğe ulaşın.
            </p>

            <div class="services-visual-line"></div>
        </div>
    </div>
</section>


<!-- HİZMETLER -->
<section class="services-catalog section-spacing" id="hizmet-listesi">
    <div class="container">

        <div class="services-catalog-heading">
            <div>
                <span class="maintenance-label">HİZMETLERİMİZ</span>
                <h2>Size nasıl yardımcı olabiliriz?</h2>
            </div>

            <p>
                Aşağıdaki hizmetleri inceleyerek ilgili detaylara
                ulaşabilir veya doğrudan işletmeyle iletişime geçebilirsiniz.
            </p>
        </div>

        <div class="services-catalog-grid">

            <!-- OTO SERVİS -->
            <article class="services-catalog-card">
                <div class="catalog-card-top">
                    <div class="catalog-icon">
                        <i class="bi bi-wrench-adjustable"></i>
                    </div>

                    <span class="catalog-number">01</span>
                </div>

                <span class="catalog-category">SERVİS</span>

                <h3>Oto Servis</h3>

                <p>
                    Aracınızın mekanik bakım ve onarım ihtiyaçları
                    için sunulan servis işlemlerini inceleyin.
                </p>

                <div class="catalog-details">
                    <div>
                        <i class="bi bi-check2"></i>
                        Mekanik bakım ve onarım
                    </div>

                    <div>
                        <i class="bi bi-check2"></i>
                        Genel araç kontrolleri
                    </div>

                    <div>
                        <i class="bi bi-check2"></i>
                        Arıza tespiti hakkında bilgi
                    </div>
                </div>

                <a asp-controller="Services"
                   asp-action="Details"
                   asp-route-id="1"
                   class="catalog-detail-link">
                    Hizmet Detayları
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>


            <!-- ARAÇ BAKIMI -->
            <article class="services-catalog-card">
                <div class="catalog-card-top">
                    <div class="catalog-icon">
                        <i class="bi bi-car-front"></i>
                    </div>

                    <span class="catalog-number">02</span>
                </div>

                <span class="catalog-category">BAKIM</span>

                <h3>Araç Bakımı</h3>

                <p>
                    Aracınızın düzenli bakım ihtiyaçları ve
                    genel kontrolleri hakkında bilgi alın.
                </p>

                <div class="catalog-details">
                    <div>
                        <i class="bi bi-check2"></i>
                        Periyodik bakım
                    </div>

                    <div>
                        <i class="bi bi-check2"></i>
                        Yağ ve filtre kontrolleri
                    </div>

                    <div>
                        <i class="bi bi-check2"></i>
                        Genel bakım ihtiyaçları
                    </div>
                </div>

                <a asp-controller="Services"
                   asp-action="Details"
                   asp-route-id="2"
                   class="catalog-detail-link">
                    Hizmet Detayları
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

        </div>

        <div class="services-catalog-note">
            <i class="bi bi-info-circle"></i>

            <p>
                Belirtilen işlemler genel bilgilendirme amaçlıdır.
                İşletmede sunulan hizmetlerin kapsamını ve aracınıza
                uygun işlemleri doğrudan iletişim kurarak teyit edebilirsiniz.
            </p>
        </div>
    </div>
</section>


<!-- BAKIM REHBERİNE YÖNLENDİRME -->
<section class="services-guide-section">
    <div class="container">
        <div class="services-guide-inner">

            <div class="services-guide-icon">
                <i class="bi bi-journal-text"></i>
            </div>

            <div class="services-guide-content">
                <span>ARACINIZI DAHA YAKINDAN TANIYIN</span>

                <h2>Araç Bakım Rehberimizi inceleyin.</h2>

                <p>
                    Motor yağı, lastikler, fren sistemi ve temel araç
                    kontrolleri hakkında hazırladığımız rehberle
                    bakım konusunda daha fazla bilgi edinin.
                </p>
            </div>

            <a asp-controller="Maintenance"
               asp-action="Index"
               class="services-guide-button">
                Rehbere Git
                <i class="bi bi-arrow-up-right"></i>
            </a>

        </div>
    </div>
</section>


<!-- ALT İLETİŞİM ÇAĞRISI -->
<section class="services-contact-section">
    <div class="container">
        <div class="services-contact-inner">
            <div>
                <span>İHTİYACINIZI BİRLİKTE DEĞERLENDİRELİM</span>

                <h2>Aracınız için hangi hizmetin uygun olduğunu öğrenin.</h2>

                <p>
                    Bize ulaşarak servis hizmetleri, adres ve
                    çalışma saatleri hakkında bilgi alabilirsiniz.
                </p>
            </div>

            <a asp-controller="Contact"
               asp-action="Index"
               class="services-contact-button">
                İletişime Geç
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>