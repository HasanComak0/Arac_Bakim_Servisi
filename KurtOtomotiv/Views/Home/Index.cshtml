@{
    ViewData["Title"] = "Anasayfa";
}

<!-- HERO / SLIDER -->
<section class="hero">
    <div id="heroCarousel"
         class="carousel slide carousel-fade"
         data-bs-ride="carousel"
         data-bs-interval="4000">

        <div class="carousel-indicators">
            <button type="button"
                    data-bs-target="#heroCarousel"
                    data-bs-slide-to="0"
                    class="active"
                    aria-current="true"
                    aria-label="Slide 1"></button>

            <button type="button"
                    data-bs-target="#heroCarousel"
                    data-bs-slide-to="1"
                    aria-label="Slide 2"></button>

            <button type="button"
                    data-bs-target="#heroCarousel"
                    data-bs-slide-to="2"
                    aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="https://lh3.googleusercontent.com/gps-cs-s/ANWiy9R07LK6uxtUnxC7wdxFEeQfsbFj7ifuMAv59lT_hIfPdmcxZ_6RzylSFItMQe6pmkvjg5OBuKmulrhVL9OeYNEw9BPnxxGdDdAYzF1nR3ldcK91BL2VAyqbrNDHunrQZNB_xRemWarKdzOl=s1360-w1360-h1020-rw"
                     class="d-block w-100"
                     alt="Kurt Otomotiv">
            </div>

            <div class="carousel-item">
                <img src="https://lh3.googleusercontent.com/gps-cs-s/ANWiy9QY9SWJVeMk-UmFB2GEx2nrrOMmUIzaX-F7kuT6-e9MmiUfogx2i4w0u88mY0x3SdU5_CkIyekc4BPNJljCkrTjEsRe6nidV0zd_Ie6ouyvQYXgnqPDEgEy3MY84dJRHzuBpEm6iPDX6NpP=s1360-w1360-h1020-rw"
                     class="d-block w-100"
                     alt="Kurt Otomotiv Servis">
            </div>

            <div class="carousel-item">
                <img src="https://lh3.googleusercontent.com/gps-cs-s/ANWiy9Tq2Hjjtdd14t6ROo8rVU5xctKQa6B-QZ9lUvS-DC_AMnOGOe8eYhlcsxVgz8FAgB2ag8SSPB1ZIC2H1-yOIXMZgpH1yvWWgi4cBsn7pE2p0fEjZfpUwkQaJmG0BRJ4daEbQQeGKHmXXSw=s1360-w1360-h1020-rw"
                     class="d-block w-100"
                     alt="Kurt Otomotiv">
            </div>

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"
                  aria-hidden="true"></span>

            <span class="visually-hidden">Önceki</span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"
                  aria-hidden="true"></span>

            <span class="visually-hidden">Sonraki</span>
        </button>

    </div>
</section>


<!-- HİZMETLERİMİZ -->
<section class="home-services section-spacing">
    <div class="container">

        <div class="home-section-heading">
            <div>
                <span class="maintenance-label">KURT OTOMOTİV</span>
                <h2>Aracınız için doğru servis çözümleri</h2>
            </div>

            <p>
                Bakım ve onarım ihtiyaçlarınız için hizmetlerimizi
                inceleyin, aracınız için uygun servis desteğini keşfedin.
            </p>
        </div>

        <div class="home-service-grid">

            <article class="home-service-card">
                <div class="home-service-icon">
                    <i class="bi bi-wrench-adjustable"></i>
                </div>

                <span class="home-card-number">01</span>

                <h3>Oto Servis</h3>

                <p>
                    Aracınızın mekanik bakım ve onarım ihtiyaçları
                    için servis hizmetlerimizi inceleyin.
                </p>

                <a asp-controller="Services"
                   asp-action="Details"
                   asp-route-id="1">
                    Hizmeti İncele
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

            <article class="home-service-card">
                <div class="home-service-icon">
                    <i class="bi bi-car-front"></i>
                </div>

                <span class="home-card-number">02</span>

                <h3>Araç Bakımı</h3>

                <p>
                    Aracınızın bakım ihtiyaçları ve düzenli kontrolleri
                    hakkında hizmet detaylarına ulaşın.
                </p>

                <a asp-controller="Services"
                   asp-action="Details"
                   asp-route-id="2">
                    Hizmeti İncele
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

            <article class="home-service-card home-service-card-featured">
                <div class="home-service-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <span class="home-card-number">03</span>

                <h3>Servis Randevusu</h3>

                <p>
                    Servis ihtiyacınızı iletmek ve size uygun
                    randevu oluşturmak için bizimle iletişime geçin.
                </p>

                <a asp-controller="Contact"
                   asp-action="Index">
                    Bize Ulaşın
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>

        </div>

        <div class="home-services-footer">
            <span>Daha fazla bilgiye mi ihtiyacınız var?</span>

            <a asp-controller="Services" asp-action="Index"
               class="home-outline-button">
                Tüm Hizmetleri Gör
                <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>

    </div>
</section>


<!-- NEDEN KURT OTOMOTİV -->
<section class="home-why-us section-spacing">
    <div class="container">

        <div class="why-us-layout">

            <div class="why-us-intro">
                <span class="maintenance-label">HİZMET ANLAYIŞIMIZ</span>

                <h2>Aracınız için bilinçli ve güvenilir servis desteği.</h2>

                <p>
                    Araç bakımında doğru bilgilendirme, ihtiyaçların
                    belirlenmesi ve yapılan işlemlerin anlaşılır olması
                    önemlidir. Servis sürecinde size yardımcı olmak
                    için buradayız.
                </p>

                <a asp-controller="Maintenance"
                   asp-action="Index"
                   class="home-outline-button">
                    Araç Bakım Rehberi
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>

            <div class="why-us-points">

                <div class="why-us-point">
                    <div class="why-us-point-icon">
                        <i class="bi bi-clipboard2-check"></i>
                    </div>

                    <div>
                        <h3>Bakım hakkında bilgi</h3>
                        <p>
                            Aracınızın bakım ihtiyaçlarını öğrenmenize
                            yardımcı olacak rehber içerikler.
                        </p>
                    </div>
                </div>

                <div class="why-us-point">
                    <div class="why-us-point-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>

                    <div>
                        <h3>Kolay iletişim</h3>
                        <p>
                            Adres, telefon ve harita üzerinden
                            işletmeye kolayca ulaşma imkânı.
                        </p>
                    </div>
                </div>

                <div class="why-us-point">
                    <div class="why-us-point-icon">
                        <i class="bi bi-calendar2-check"></i>
                    </div>

                    <div>
                        <h3>Servis sürecine kolay erişim</h3>
                        <p>
                            Hizmetleri inceleyebilir ve servis
                            ihtiyacınız için iletişime geçebilirsiniz.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </div>
</section>


<!-- İLETİŞİM ÇAĞRISI -->
<section class="home-contact-cta">
    <div class="container">

        <div class="home-contact-cta-inner">
            <div>
                <span>ARACINIZ İÇİN DESTEĞE Mİ İHTİYACINIZ VAR?</span>

                <h2>Bir sonraki adım için bizimle iletişime geçin.</h2>

                <p>
                    Konumumuzu görüntüleyin, iletişim bilgilerimize ulaşın
                    ve servis ihtiyacınızı bize iletin.
                </p>
            </div>

            <a asp-controller="Contact"
               asp-action="Index"
               class="home-cta-button">
                İletişime Geç
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

    </div>
</section>