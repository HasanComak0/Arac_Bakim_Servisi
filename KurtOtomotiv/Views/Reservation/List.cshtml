@model List<KurtOtomotiv.Models.Reservation>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}



<h1>Rezervasyonlar</h1>

<table>
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Telefon</th>
            <th>Araç</th>
            <th>Hizmet</th>
            <th>Tarih</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var reservation in Model)
        {
            <tr>
                <td>@reservation.FullName</td>
                <td>@reservation.Phone</td>
                <td>@reservation.VehicleBrand @reservation.VehicleModel</td>
                <td>@reservation.ServiceType</td>
                <td>@reservation.PreferredDate.ToString("dd.MM.yyyy")</td>
            </tr>
        }
    </tbody>
</table>
